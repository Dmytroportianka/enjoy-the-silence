# Copy to .env (Bun loads it automatically) or export in your shell.
# Every setting is optional; defaults run the bundled snapshot.

# Port and bind address for the showcase server.
PORT=4317
HOST=localhost

# Point at a checkout of the reference repo to render live data
# (Caddy routes, Agent presets, fleet binaries, git log).
# Unset or unreachable -> falls back to data/snapshot.json.
# REPO_ROOT=/home/you/nixos-config

# Regenerate the bundled snapshot from that repo:
#   REPO_ROOT=/home/you/nixos-config bun run snapshot

# Pitch customization (handy when reusing this for another project):
# SHOWCASE_TITLE=My Agent OS
# SHOWCASE_TAGLINE=NixOS is the body. The crew is the hands. Muse is the brain.
# SHOWCASE_ACCENT=#c2410c
